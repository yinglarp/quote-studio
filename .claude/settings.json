{
  "permissions": {
    "allow": [
      "Edit(/desk/packs/**)",
      "Edit(/outputs/drafts/**)",
      "Edit(/outputs/quotes/**)",
      "Edit(/outputs/open-items.md)",
      "Edit(/outputs/run-log.md)"
    ],
    "ask": [
      "Bash",
      "PowerShell",
      "Edit(/design/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/**)",
      "Edit(/human-role.md)"
    ],
    "deny": [
      "Read(**/staff)",
      "Read(**/staff/**)",
      "Edit(**/staff/**)",
      "Read(**/reference/costing-and-margins.xlsx)",
      "Edit(**/reference/costing-and-margins.xlsx)",
      "Edit(/quote-calculator/**)",
      "Edit(/inbox/**)",
      "Edit(/reference/**)",
      "Edit(/desk/bookings.csv)",
      "Edit(/desk/desk-rules.md)",
      "Edit(/desk/allowed-values.md)",
      "Edit(/desk/menu-and-dietary.md)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "Bash(gh repo delete*)",
      "PowerShell(gh repo delete*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.js\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking project rules"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/desk_stop.py\"",
            "timeout": 300,
            "statusMessage": "Validating the Desk run"
          }
        ]
      }
    ]
  }
}
