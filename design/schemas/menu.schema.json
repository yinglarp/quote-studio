{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "menu.json",
  "description": "Menu to Drafter. design/contracts.md, section 4.",
  "type": "object",
  "required": ["package", "halal", "vegetarian_guests", "vegetarian_dishes", "clashes", "shared_kitchen_note",
               "verdict", "dietary_status", "open_questions"],
  "additionalProperties": false,
  "properties": {
    "package": {"enum": ["bento_classic", "bento_premium", "mini_buffet", "classic_buffet", "premium_buffet", null]},
    "halal": {"const": true},
    "vegetarian_guests": {"type": ["integer", "null"], "minimum": 0},
    "vegetarian_dishes": {"type": ["integer", "null"], "minimum": 0},
    "clashes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["allergen", "guests", "severity", "dishes"],
        "additionalProperties": false,
        "properties": {
          "allergen": {"type": "string", "maxLength": 40},
          "guests": {"type": ["integer", "null"], "minimum": 1},
          "severity": {"type": "string", "maxLength": 20},
          "dishes": {"type": "array", "items": {"type": "string", "maxLength": 60}}
        }
      }
    },
    "shared_kitchen_note": {"type": "boolean"},
    "verdict": {"enum": ["OK", "FLAG"]},
    "dietary_status": {"enum": ["verified", "assumed", "missing"]},
    "open_questions": {"type": "array", "items": {"type": "string", "maxLength": 200}}
  },
  "allOf": [
    {"if": {"required": ["clashes"], "properties": {"clashes": {"minItems": 1}}}, "then": {"properties": {"verdict": {"const": "FLAG"}}}},
    {"if": {"required": ["dietary_status"], "properties": {"dietary_status": {"enum": ["assumed", "missing"]}}}, "then": {"properties": {"verdict": {"const": "FLAG"}}}}
  ]
}
