{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quote.json",
  "description": "Quote engine to Drafter, saved unchanged. design/contracts.md, section 5. Extra engine fields are allowed.",
  "type": "object",
  "required": ["status"],
  "properties": {
    "status": {"enum": ["ok", "refused"]},
    "reason": {"type": "string", "maxLength": 200},
    "quote_number": {"type": "string", "pattern": "^Q-\\d{8}-[A-Z0-9]+-\\d{4}$"},
    "issue_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "valid_until": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "event_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "headcount": {"type": "integer", "minimum": 1},
    "package_name": {"type": "string", "maxLength": 60},
    "delivery_zone_name": {"type": "string", "maxLength": 60},
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["description", "quantity", "unit", "unit_price", "amount"],
        "properties": {
          "description": {"type": "string", "maxLength": 80},
          "quantity": {"type": ["string", "number"]},
          "unit": {"type": "string", "maxLength": 20},
          "unit_price": {"type": "string", "pattern": "^\\d+\\.\\d{2}$"},
          "amount": {"type": "string", "pattern": "^\\d+\\.\\d{2}$"}
        }
      }
    },
    "order_value": {"type": "string", "pattern": "^\\d+\\.\\d{2}$"},
    "delivery_charge": {"type": "string", "pattern": "^\\d+\\.\\d{2}$"},
    "subtotal": {"type": "string", "pattern": "^\\d+\\.\\d{2}$"},
    "gst": {"type": "string", "pattern": "^\\d+\\.\\d{2}$"},
    "total": {"type": "string", "pattern": "^\\d+\\.\\d{2}$"},
    "deposit": {"type": "string", "pattern": "^\\d+\\.\\d{2}$"},
    "balance": {"type": "string", "pattern": "^\\d+\\.\\d{2}$"},
    "gst_rate": {"type": "string", "pattern": "^0\\.\\d+$"},
    "deposit_rate": {"type": "string", "pattern": "^0\\.\\d+$"},
    "delivery_free_reason": {"type": "string", "maxLength": 120},
    "terms_file": {"type": "string", "pattern": "^terms-\\d{4}\\.md$"},
    "terms_note": {"type": "string", "maxLength": 200},
    "cancellation_plain": {"type": "string"},
    "confirm_items": {"type": "array", "items": {"type": "string", "maxLength": 200}},
    "prices_checked_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
  },
  "allOf": [
    {"if": {"required": ["status"], "properties": {"status": {"const": "ok"}}},
     "then": {"required": ["quote_number", "issue_date", "valid_until", "event_date", "headcount", "package_name",
                           "delivery_zone_name", "lines", "order_value", "delivery_charge", "subtotal", "gst", "total",
                           "deposit", "balance", "gst_rate", "deposit_rate", "delivery_free_reason", "terms_file",
                           "terms_note", "cancellation_plain", "confirm_items", "prices_checked_on"]}},
    {"if": {"required": ["status"], "properties": {"status": {"const": "refused"}}}, "then": {"required": ["reason"]}}
  ]
}
